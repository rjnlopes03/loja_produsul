# URL do PostgreSQL. Sem ela, o backend usa o SQLite local (loja.db).
DATABASE_URL=postgresql://usuario:senha@host:5432/loja

# Origens extras liberadas no CORS, separadas por vírgula (ex.: domínio da Vercel).
CORS_ORIGINS=https://loja-produsul.vercel.app

# Senha do administrador. Obrigatória em produção (com DATABASE_URL); sem ela, o login fica desligado.
ADMIN_PASSWORD=troque-esta-senha
